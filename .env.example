# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

# Base de datos (docker-compose sobrescribe DB_HOST/DB_PORT para el backend)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=autofacapi
DB_USERNAME=root
DB_PASSWORD=cambia_esta_clave

# Siigo (captura automatica de facturas)
SIIGO_EMAIL=
SIIGO_PASSWORD=
SIIGO_SYNC_CRON=0 0 23 * * *
SIIGO_SYNC_ZONE=America/Bogota

# Administrador inicial (se crea si no existe)
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=cambia_esta_clave

# JWT: genera una clave propia, por ejemplo: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION=3600000

# Origenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:4200

# Usuario demo de solo lectura (vacio = no se crea)
DEMO_EMAIL=demo@autofac.com
DEMO_PASSWORD=Demo2026
DEMO_OCULTAR_DATOS_CLIENTES=true
